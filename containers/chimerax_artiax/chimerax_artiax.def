Bootstrap: docker
From: ubuntu:22.04

# Self-contained ChimeraX + ArtiaX curation appliance for CBE.
# NO manual downloads: %post fetches ChimeraX from UCSF (the non-commercial license is
# auto-accepted via the download CGI) and bakes in ArtiaX. ArtiaX picking is slice-based, so this
# uses Mesa SOFTWARE OpenGL (llvmpipe) — no GPU, no VirtualGL, no driver matching.
#
# BUILD (fakeroot works on CBE via a root-mapped namespace):
#   apptainer build --fakeroot chimerax_artiax.sif chimerax_artiax.def
#   cp chimerax_artiax.sif /groups/klumpe/software/Setup/cryoboost_containers/   # or set CX_SIF
# Needs outbound HTTPS during the build (same as the docker:// base pull).
#
# Bump ChimeraX: edit CHIMERAX_VERSION in %post to a current STABLE production release.
# For a GPU node instead of software GL: drop the LIBGL/GALLIUM lines below and run with --nv.

%environment
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
    export QT_X11_NO_MITSHM=1
    # ArtiaX is baked into /opt/cx/share and loads from there (read-only is fine for DATA).
    export XDG_DATA_HOME=/opt/cx/share
    # Config + cache MUST be writable. The baked /opt/cx is read-only, so do NOT point
    # XDG_CONFIG_HOME at it — that makes ChimeraX fail to create its config dir at
    # runtime. Leaving it unset → ChimeraX writes config to the writable ~/.config.
    # The curation worker overrides config+cache to unique /tmp dirs per run.
    export XDG_CACHE_HOME=/tmp/cx-cache

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    CHIMERAX_VERSION=1.9        # <-- bump to a current STABLE production release
    UBUNTU_REL=22.04            # must match the 'From:' base image above

    apt-get update
    # x11vnc is here ONLY for `x11vnc -storepasswd`: TigerVNC 1.12's packages ship the
    # server (Xtigervnc/vncserver) but no vncpasswd, and the image has no python — so
    # this is how the curation worker mints the standard 8-byte VncAuth password file.
    apt-get install -y --no-install-recommends \
        curl ca-certificates \
        libgl1-mesa-glx libgl1-mesa-dri libglu1-mesa mesa-utils \
        libegl1 libopengl0 \
        tigervnc-standalone-server tigervnc-common fluxbox xterm dbus-x11 \
        x11vnc \
        fonts-dejavu-core \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-xkb1 libxcb-util1 libxcb-glx0 libxkbcommon-x11-0 libxkbcommon0 \
        libx11-xcb1 libsm6 libice6 libxext6 libxrender1 libxi6 libxtst6 \
        libxrandr2 libxfixes3 libxcursor1 libxdamage1 libxcomposite1 \
        libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0 libnss3

    # --- fetch the ChimeraX .deb from UCSF, accepting the non-commercial license ---
    DEB="ucsf-chimerax_${CHIMERAX_VERSION}ubuntu${UBUNTU_REL}_amd64.deb"
    FILE="${CHIMERAX_VERSION}/ubuntu-${UBUNTU_REL}/${DEB}"
    DOMAIN="https://www.cgl.ucsf.edu"
    CGI="${DOMAIN}/chimerax/cgi-bin/secure/chimerax-get.py"
    echo "Fetching ChimeraX ${CHIMERAX_VERSION} (ubuntu ${UBUNTU_REL})…"
    ACCEPT_HTML=$(curl -fsSL --data-urlencode "file=${FILE}" --data-urlencode "choice=Accept" "$CGI")
    # The accept response embeds the real download link as an absolute path. Anchor on /chimerax/
    # so we skip the meta-refresh "2;url=" prefix: content="2;url=/chimerax/.../chimerax-get.py?...&choice=Notified"
    REL=$(printf '%s' "$ACCEPT_HTML" | grep -oE "/chimerax/cgi-bin/secure/chimerax-get\.py\?[^\"'<> ]*choice=Notified" | head -1 | sed 's/&amp;/\&/g')
    if [ -z "$REL" ]; then
        echo "ERROR: could not parse a download URL from the license response."
        echo "       Check that ChimeraX ${CHIMERAX_VERSION} ships an ubuntu${UBUNTU_REL} .deb."
        exit 1
    fi
    URL="${DOMAIN}${REL}"
    curl -fSL -o /tmp/chimerax.deb "$URL"
    dpkg-deb --info /tmp/chimerax.deb >/dev/null 2>&1 || { echo "ERROR: download is not a .deb (got an HTML page?)"; exit 1; }
    apt-get install -y /tmp/chimerax.deb
    rm -f /tmp/chimerax.deb

    # ChimeraX bundles Qt6 under PyQt6/Qt6/lib, not on the loader's default path —
    # register it so PyQt6/QtCore.abi3.so can resolve libQt6Core.so.6.
    QT6LIB=$(dirname "$(find /usr/lib/ucsf-chimerax -name libQt6Core.so.6 2>/dev/null | head -1)")
    [ -n "$QT6LIB" ] && [ -d "$QT6LIB" ] || { echo "ERROR: bundled Qt6 not found (libQt6Core.so.6)"; exit 1; }
    echo "$QT6LIB" > /etc/ld.so.conf.d/chimerax-qt6.conf

    # The cluster runs CentOS 7 (kernel 3.10), OLDER than the Ubuntu 22.04 Qt6 libs'
    # NT_GNU_ABI_TAG (Linux 4.11). glibc's loader refuses any library tagged for a
    # newer kernel than the running one — surfacing as "libQt6Core.so.6: cannot open
    # shared object file" even though the file is present AND in the ld cache. Strip
    # .note.ABI-tag from ChimeraX's bundled libs so the loader stops enforcing a
    # minimum kernel (glibc has runtime fallbacks for the few newer syscalls — e.g.
    # statx — that the tag came from). Then rebuild the cache so entries carry no
    # kernel minimum.
    apt-get install -y --no-install-recommends binutils
    find /usr/lib/ucsf-chimerax \( -name '*.so' -o -name '*.so.*' \) -type f 2>/dev/null | while read -r so; do
        objcopy --remove-section=.note.ABI-tag "$so" 2>/dev/null || true
    done
    ldconfig
    echo "Stripped ABI tags + registered bundled Qt6 lib dir: $QT6LIB"

    # --- bake ArtiaX into the image (loaded read-only at runtime; cache redirected to /tmp) ---
    export XDG_DATA_HOME=/opt/cx/share XDG_CONFIG_HOME=/opt/cx/config XDG_CACHE_HOME=/tmp/cx-cache
    mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"
    # Refresh the toolshed catalog FIRST — without it: "ArtiaX does not match any bundles".
    chimerax --nogui --silent --exit --cmd "toolshed reload all ; toolshed install ArtiaX ; exit"
    # Hard-fail the build if ArtiaX didn't actually land in the baked data dir (no silent no-ArtiaX SIF).
    find /opt/cx -iname '*artiax*' -print -quit 2>/dev/null | grep -q . \
        || { echo "ERROR: ArtiaX did not install into /opt/cx (toolshed reload/network, or ChimeraX ignored XDG_DATA_HOME)"; exit 1; }
    chmod -R a+rX /opt/cx

    apt-get clean && rm -rf /var/lib/apt/lists/*

%runscript
    exec /bin/bash "$@"
