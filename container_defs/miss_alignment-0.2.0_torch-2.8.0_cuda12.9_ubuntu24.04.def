Bootstrap: docker
From: ubuntu@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
# ubuntu:24.04 on 2026-11-25, by digest (Apptainer takes a tag or a digest, not both). Roadmap 63 D17.

# miss-alignment 0.2.0 (warpem's learned tilt-series alignment) with torch 2.8.0 and torch-projectors 0.12.0+cu129,
# Python 3.12, on plain Ubuntu 24.04. Since HOTFIXES H26 this image is also the runtime of the Warp-geometry bridge
# (warpylib, starfile). The environment of the image the lab runs (miss_alignment_torch2.8.0_cuda12.9.sif, whose
# environment holds conda's cuda-toolkit 12.9, not the cuda-runtime its def of record asks for: recon C02), installed
# from the locks exported from it: conda packages by URL and md5, pip ones by version (torch-projectors' +cu129 wheel
# is on warpem's own index, so the pip lock carries no hashes). Moving to cuda-runtime alone is roadmap 63 S7's step,
# after this image is checked against the running one.

%files
    build_env.sh /opt/crboost/build_env.sh
    miss_alignment-0.2.0_torch-2.8.0_cuda12.9_ubuntu24.04.conda.lock /opt/locks/conda.lock
    miss_alignment-0.2.0_torch-2.8.0_cuda12.9_ubuntu24.04.pip.lock /opt/locks/pip.lock

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=""
    export PYTHONHOME=""
    export PATH="/opt/miniforge3/envs/miss-alignment/bin:/opt/miniforge3/bin:$PATH"
    export CUDA_HOME="/opt/miniforge3/envs/miss-alignment"
    export LD_LIBRARY_PATH="/opt/miniforge3/envs/miss-alignment/lib:$LD_LIBRARY_PATH"

%post
    set -e
    . /opt/crboost/build_env.sh
    apt_install ca-certificates curl
    install_miniforge

    conda create -n miss-alignment -y --file /opt/locks/conda.lock
    P=/opt/miniforge3/envs/miss-alignment/bin/python
    $P -m pip install --no-cache-dir --no-deps \
        --extra-index-url https://warpem.github.io/torch-projectors/cu129/simple/ -r /opt/locks/pip.lock
    conda clean --all -y

    # Verify here, not in %test: a failing %test does not fail an Apptainer build.
    $P -m pip check
    $P -c "import importlib.metadata as m; v = {p: m.version(p) for p in ('miss-alignment', 'torch', 'torch-projectors', 'warpylib', 'starfile')}; print(v); assert v['miss-alignment'] == '0.2.0' and v['torch'] == '2.8.0', v"
    # get_arch_list() is [] without a GPU; the compiled-in flags are not.
    $P -c "import torch; a = torch._C._cuda_getArchFlags(); print(torch.__version__, a); assert 'sm_100' in a, a"
    $P -c "import miss_alignment, warpylib, starfile"
    # torch_projectors' CUDA extension loads its libraries without a GPU.
    $P -c "import torch_projectors"
    /opt/miniforge3/envs/miss-alignment/bin/miss-alignment --help > /dev/null

%runscript
    if [ $# -gt 0 ]; then
        exec "$@"
    else
        exec /bin/bash
    fi

%test
    # The real checks run at the end of %post (a failing %test does not fail the build).
    command -v miss-alignment

%labels
    crboost.tool miss_alignment
    crboost.def miss_alignment-0.2.0_torch-2.8.0_cuda12.9_ubuntu24.04
    org.opencontainers.image.title miss-alignment
    org.opencontainers.image.version 0.2.0
    org.opencontainers.image.source https://github.com/Klumpe-lab/crboost_server
    org.opencontainers.image.licenses miss-alignment, torch-projectors, warpylib, conda-forge and PyPI packages under their own

%help
    miss-alignment 0.2.0 with torch 2.8.0 and torch-projectors 0.12.0+cu129 (Python 3.12), and the Warp-geometry
    bridge's warpylib and starfile, on Ubuntu 24.04.
    Use with: apptainer exec --nv --no-home <image>.sif miss-alignment --help
