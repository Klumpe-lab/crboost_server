Bootstrap: docker
From: ubuntu@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
# ubuntu:24.04 on 2026-11-25, by digest (Apptainer takes a tag or a digest, not both). Roadmap 63 D17.

# cryoCARE 0.3.0 with TensorFlow 2.4.0 on CUDA 11.0 and cuDNN 8.0 from conda-forge (Python 3.8), on plain Ubuntu 24.04.
# The environment of the image the lab runs (cryocare.sif, built from cryocare.def on NVIDIA's CUDA 11.8 devel base,
# which it never used: TF loads the environment's CUDA), installed from the locks exported from it: conda packages
# by URL and md5 (all conda-forge, though that def went through Anaconda's Miniconda and accepted its terms), pip
# ones by version and sha256. cryoCARE, termcolor and wrapt ship as sources only; they build without a compiler
# (wrapt then runs its pure-Python fallback). No TF release carries Blackwell code: on a B200 its kernels compile from
# PTX at first use (the conf's gpu_kernel_cache keeps them).

%files
    build_env.sh /opt/crboost/build_env.sh
    cryocare-0.3.0_tensorflow-2.4_cuda11.0_ubuntu24.04.conda.lock /opt/locks/conda.lock
    cryocare-0.3.0_tensorflow-2.4_cuda11.0_ubuntu24.04.pip.lock /opt/locks/pip.lock

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=""
    export PYTHONHOME=""
    export PATH="/opt/miniforge3/envs/cryocare/bin:/opt/miniforge3/bin:$PATH"
    export LD_LIBRARY_PATH="/opt/miniforge3/envs/cryocare/lib:$LD_LIBRARY_PATH"
    export TF_CPP_MIN_LOG_LEVEL=2

%post
    set -e
    . /opt/crboost/build_env.sh
    apt_install ca-certificates curl
    install_miniforge

    conda create -n cryocare -y --file /opt/locks/conda.lock
    P=/opt/miniforge3/envs/cryocare/bin/python
    $P -m pip install --no-cache-dir --no-deps --require-hashes -r /opt/locks/pip.lock
    conda clean --all -y

    # Verify here, not in %test: a failing %test does not fail an Apptainer build.
    $P -m pip check
    $P -c "import tensorflow as tf; assert tf.__version__ == '2.4.0', tf.__version__; assert tf.test.is_built_with_cuda()"
    $P -c "import cryocare, importlib.metadata as m; v = m.version('cryoCARE'); print('cryoCARE', v); assert v == '0.3.0', v"
    # TF 2.4 loads CUDA 11.0's libraries (cusolver 10) and cuDNN 8 from the environment (no GPU needed to find them).
    for l in libcudart.so.11.0 libcublas.so.11 libcufft.so.10 libcurand.so.10 libcusolver.so.10 libcusparse.so.11 libcudnn.so.8; do
        test -e /opt/miniforge3/envs/cryocare/lib/$l || { echo "missing $l"; exit 1; }
    done
    for c in cryoCARE_extract_train_data.py cryoCARE_train.py cryoCARE_predict.py; do test -x /opt/miniforge3/envs/cryocare/bin/$c; done

%runscript
    if [ $# -gt 0 ]; then
        exec "$@"
    else
        exec /bin/bash
    fi

%test
    # The real checks run at the end of %post (a failing %test does not fail the build).
    command -v cryoCARE_predict.py

%labels
    crboost.tool cryocare
    crboost.def cryocare-0.3.0_tensorflow-2.4_cuda11.0_ubuntu24.04
    org.opencontainers.image.title cryoCARE
    org.opencontainers.image.version 0.3.0
    org.opencontainers.image.source https://github.com/Klumpe-lab/crboost_server
    org.opencontainers.image.licenses cryoCARE, TensorFlow, conda-forge and PyPI packages under their own

%help
    cryoCARE 0.3.0 with TensorFlow 2.4.0 (CUDA 11.0, cuDNN 8.0, Python 3.8), on Ubuntu 24.04.
    Use with: apptainer exec --nv <image>.sif cryoCARE_predict.py --conf <predict_config.json>
