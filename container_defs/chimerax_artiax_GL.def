Bootstrap: docker
From: ubuntu:22.04

# GPU / VirtualGL variant of the ChimeraX + ArtiaX curation appliance for CBE.
#
# Why this exists: the base chimerax_artiax.sif forces Mesa SOFTWARE GL (llvmpipe)
# on a CPU node, which makes 3-D rendering 3-5 s/frame (see reference_chimerax_vnc_perf).
# A plain GPU node does NOT help by itself — a TigerVNC Xvnc server does software
# GLX. VirtualGL is what bypasses the X server's software GLX: it renders OpenGL on
# the GPU and reads the frames back into the Xvnc desktop. So this image bakes in
# VirtualGL and is meant to be launched on a GPU node with `--nv` + `vglrun`.
#
# BUILD (fakeroot works on CBE via a root-mapped namespace):
#   apptainer build --fakeroot chimerax_artiax_GL.sif chimerax_artiax_GL.def
#   # point conf.yaml curation.sif_path (or CX_SIF) at the built _GL.sif
#
# RUN (the worker does this for you when CX_VGL is set):
#   apptainer exec --nv ...binds... chimerax_artiax_GL.sif \
#       /opt/VirtualGL/bin/vglrun -d egl chimerax
#   `vglrun -d egl` uses VGL's EGL back-end → renders on the GPU headlessly, no
#   separate 3-D X server needed; only the 2-D Xvnc desktop.
#   Quick manual test:  CX_SIF=/path/chimerax_artiax_GL.sif ./launch_curation_vnc.sh g
#
# LIKELY SNAGS (this is fiddly container GL — expect a round or two):
#   1. `vglrun` can't open an EGL device → try `-d /dev/dri/card0` (or card1) instead
#      of `-d egl`; confirm the GPU node injected /dev/nvidia* (it should with --nv).
#   2. ChimeraX still renders software (no speedup) → VGL didn't intercept. Check
#      `vglrun -v chimerax` output for "Attempting to use EGL"; ensure the bundled
#      Mesa libGL isn't winning — VGL's faker (LD_PRELOAD by vglrun) must load first.
#   3. "libvglfaker.so: cannot open shared object file" despite being present → the
#      CentOS-7 kernel-3.10 vs newer-ABI-tag trap (reference_cbe_kernel_abi); %post
#      below strips .note.ABI-tag from the VGL libs, but re-check if you bump VGL.
#   4. Qt uses EGL not GLX (rare for ChimeraX's xcb/QOpenGLWidget path) → VGL's GLX
#      interception won't fire; try `vglrun +wm` / the EGL front-end. Unlikely here.
#   5. Driver/userspace mismatch from --nv → host NVIDIA libs must match the GPU
#      driver; that's a node-config issue, not the container.

%environment
    # NO software-GL forcing here (that's the whole point) — the GPU + VirtualGL
    # provide hardware GL. Mesa stays installed as the 2-D / no-VGL fallback.
    export QT_X11_NO_MITSHM=1
    export PATH=/opt/VirtualGL/bin:$PATH
    # ArtiaX is baked into /opt/cx/share and loads from there (read-only is fine for DATA).
    export XDG_DATA_HOME=/opt/cx/share
    # Config + cache MUST be writable. The baked /opt/cx is read-only, so do NOT point
    # XDG_CONFIG_HOME at it — the curation worker overrides config+cache to unique /tmp
    # dirs per run; leaving XDG_CONFIG_HOME unset → ChimeraX writes to writable ~/.config.
    export XDG_CACHE_HOME=/tmp/cx-cache

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    CHIMERAX_VERSION=1.9        # <-- bump to a current STABLE production release
    UBUNTU_REL=22.04            # must match the 'From:' base image above
    VGL_VERSION=3.1.4           # VirtualGL release (verified 2026-06-03: virtualgl_3.1.4_amd64.deb); EGL back-end needs >= 3.0

    apt-get update
    # x11vnc is here ONLY for `x11vnc -storepasswd`: TigerVNC 1.12's packages ship the
    # server (Xtigervnc/vncserver) but no vncpasswd, and the image has no python — so
    # this is how the curation worker mints the standard 8-byte VncAuth password file.
    apt-get install -y --no-install-recommends \
        curl ca-certificates \
        libgl1-mesa-glx libgl1-mesa-dri libglu1-mesa mesa-utils \
        libegl1 libopengl0 libglvnd0 libglx0 \
        tigervnc-standalone-server tigervnc-common fluxbox xterm dbus-x11 \
        x11vnc \
        fonts-dejavu-core \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-xkb1 libxcb-util1 libxcb-glx0 libxkbcommon-x11-0 libxkbcommon0 \
        libx11-xcb1 libsm6 libice6 libxext6 libxrender1 libxi6 libxtst6 \
        libxrandr2 libxfixes3 libxcursor1 libxdamage1 libxcomposite1 \
        libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0 libnss3

    # QtWebEngine runtime for ChimeraX's Log panel. Without these the Log fails to
    # render (QtWebEngine can't init) and command errors vanish into a dead panel —
    # which is exactly why the scipy failure below was invisible in the GUI.
    apt-get install -y --no-install-recommends libgbm1 libasound2 libxshmfence1

    # --- VirtualGL (not in apt) — fetch the .deb from the VGL GitHub release ---
    VGL_DEB="virtualgl_${VGL_VERSION}_amd64.deb"
    VGL_URL="https://github.com/VirtualGL/virtualgl/releases/download/${VGL_VERSION}/${VGL_DEB}"
    echo "Fetching VirtualGL ${VGL_VERSION}…"
    curl -fSL -o /tmp/virtualgl.deb "$VGL_URL"
    dpkg-deb --info /tmp/virtualgl.deb >/dev/null 2>&1 || { echo "ERROR: VGL download is not a .deb (URL 404 — bump VGL_VERSION?)"; exit 1; }
    apt-get install -y /tmp/virtualgl.deb
    rm -f /tmp/virtualgl.deb
    command -v /opt/VirtualGL/bin/vglrun >/dev/null 2>&1 || { echo "ERROR: vglrun not found after VGL install"; exit 1; }

    # apptainer `--nv` injects the NVIDIA EGL/GLX *libraries* (libEGL_nvidia.so.0 …)
    # but NOT the GLVND EGL *vendor config* — so libEGL sees only Mesa (50_mesa.json),
    # probes the cgroup-denied /dev/dri DRM nodes, and falls back to llvmpipe software
    # GL (the whole 3-5 s lag). Register the NVIDIA EGL ICD ourselves so GLVND uses the
    # --nv-injected libEGL_nvidia at runtime. 10_ sorts before 50_mesa = preferred;
    # the worker also pins __EGL_VENDOR_LIBRARY_FILENAMES at this exact file.
    mkdir -p /usr/share/glvnd/egl_vendor.d
    cat > /usr/share/glvnd/egl_vendor.d/10_nvidia.json <<'JSON'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "libEGL_nvidia.so.0"
    }
}
JSON

    # --- fetch the ChimeraX .deb from UCSF, accepting the non-commercial license ---
    DEB="ucsf-chimerax_${CHIMERAX_VERSION}ubuntu${UBUNTU_REL}_amd64.deb"
    FILE="${CHIMERAX_VERSION}/ubuntu-${UBUNTU_REL}/${DEB}"
    DOMAIN="https://www.cgl.ucsf.edu"
    CGI="${DOMAIN}/chimerax/cgi-bin/secure/chimerax-get.py"
    echo "Fetching ChimeraX ${CHIMERAX_VERSION} (ubuntu ${UBUNTU_REL})…"
    ACCEPT_HTML=$(curl -fsSL --data-urlencode "file=${FILE}" --data-urlencode "choice=Accept" "$CGI")
    # The accept response embeds the real download link as an absolute path. Anchor on /chimerax/
    # so we skip the meta-refresh "2;url=" prefix: content="2;url=/chimerax/.../chimerax-get.py?...&choice=Notified"
    REL=$(printf '%s' "$ACCEPT_HTML" | grep -oE "/chimerax/cgi-bin/secure/chimerax-get\.py\?[^\"'<> ]*choice=Notified" | head -1 | sed 's/&amp;/\&/g')
    if [ -z "$REL" ]; then
        echo "ERROR: could not parse a download URL from the license response."
        echo "       Check that ChimeraX ${CHIMERAX_VERSION} ships an ubuntu${UBUNTU_REL} .deb."
        exit 1
    fi
    URL="${DOMAIN}${REL}"
    curl -fSL -o /tmp/chimerax.deb "$URL"
    dpkg-deb --info /tmp/chimerax.deb >/dev/null 2>&1 || { echo "ERROR: download is not a .deb (got an HTML page?)"; exit 1; }
    apt-get install -y /tmp/chimerax.deb
    rm -f /tmp/chimerax.deb

    # ChimeraX bundles Qt6 under PyQt6/Qt6/lib, not on the loader's default path —
    # register it so PyQt6/QtCore.abi3.so can resolve libQt6Core.so.6.
    QT6LIB=$(dirname "$(find /usr/lib/ucsf-chimerax -name libQt6Core.so.6 2>/dev/null | head -1)")
    [ -n "$QT6LIB" ] && [ -d "$QT6LIB" ] || { echo "ERROR: bundled Qt6 not found (libQt6Core.so.6)"; exit 1; }
    echo "$QT6LIB" > /etc/ld.so.conf.d/chimerax-qt6.conf

    # The cluster runs CentOS 7 (kernel 3.10), OLDER than the Ubuntu 22.04 libs'
    # NT_GNU_ABI_TAG (Linux 4.11). glibc's loader refuses any library tagged for a
    # newer kernel than the running one — surfacing as "cannot open shared object
    # file" even though the file is present AND in the ld cache. Strip .note.ABI-tag
    # from ChimeraX's bundled libs AND VirtualGL's libs (libvglfaker etc. are LD_PRELOAD'd
    # into ChimeraX by vglrun, so they hit the same trap) so the loader stops enforcing
    # a minimum kernel. Then rebuild the cache so entries carry no kernel minimum.
    apt-get install -y --no-install-recommends binutils
    find /usr/lib/ucsf-chimerax /opt/VirtualGL \( -name '*.so' -o -name '*.so.*' \) -type f 2>/dev/null | while read -r so; do
        objcopy --remove-section=.note.ABI-tag "$so" 2>/dev/null || true
    done
    ldconfig
    echo "Stripped ABI tags (ChimeraX + VirtualGL) + registered bundled Qt6 lib dir: $QT6LIB"

    # --- CBE el7 fix: replace ChimeraX's scipy with a manylinux2014 build ---
    # ChimeraX 1.9 bundles a scipy whose vendored OpenBLAS (libscipy_openblas-*.so) is
    # built for glibc>=2.28 and is REJECTED by this cluster's CentOS-7 kernel-3.10 loader:
    #   ImportError: libscipy_openblas-*.so: ELF load command address/offset not page-aligned
    # That silently kills EVERY `artiax` command — ArtiaX imports scipy on first use, and
    # the traceback vanishes into the (separately-broken) Log panel, so the command just
    # appears to do nothing. This is NOT the .note.ABI-tag trap: objcopy can't fix segment
    # alignment, which is why the strip sweep above never helped scipy. The fix is a
    # different WHEEL — manylinux2014 scipy is el7-built and page-aligned. Pin the proven
    # 1.11.4; keep numpy at the bundled 1.26.4 (which already loads). Placed AFTER the
    # objcopy sweep on purpose: these fresh el7 wheels must NOT be stripped (that's the
    # exact state validated headlessly). The import assertion hard-fails a regression.
    /usr/lib/ucsf-chimerax/bin/python3.11 -m pip install --force-reinstall --no-cache-dir "numpy==1.26.4" "scipy==1.11.4"
    /usr/lib/ucsf-chimerax/bin/python3.11 -c "import scipy.linalg; print('scipy', __import__('scipy').__version__, 'loads on el7 OK')"

    # --- bake ArtiaX into the image (loaded read-only at runtime; cache redirected to /tmp) ---
    export XDG_DATA_HOME=/opt/cx/share XDG_CONFIG_HOME=/opt/cx/config XDG_CACHE_HOME=/tmp/cx-cache
    mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"
    # Refresh the toolshed catalog FIRST — without it: "ArtiaX does not match any bundles".
    chimerax --nogui --silent --exit --cmd "toolshed reload all ; toolshed install ArtiaX ; exit"
    # Hard-fail the build if ArtiaX didn't actually land in the baked data dir (no silent no-ArtiaX SIF).
    find /opt/cx -iname '*artiax*' -print -quit 2>/dev/null | grep -q . \
        || { echo "ERROR: ArtiaX did not install into /opt/cx (toolshed reload/network, or ChimeraX ignored XDG_DATA_HOME)"; exit 1; }
    chmod -R a+rX /opt/cx

    apt-get clean && rm -rf /var/lib/apt/lists/*

%runscript
    exec /bin/bash "$@"
