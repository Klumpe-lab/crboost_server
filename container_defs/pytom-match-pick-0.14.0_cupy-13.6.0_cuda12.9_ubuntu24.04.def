Bootstrap: docker
From: ubuntu@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
# ubuntu:24.04 on 2026-11-25, by digest (Apptainer takes a tag or a digest, not both). Roadmap 63 D17.

# pytom-match-pick 0.14.0 with cupy 13.6.0 and CUDA 12.9 from conda-forge, on plain Ubuntu 24.04.
# The environment of the image the lab runs (pytom-match-pick-0.14.0_cupy-13.6.0_cuda12.9_sm100.def), installed from
# the locks exported from it: conda packages by URL and md5, pip ones by version and sha256, wheels only, so nothing
# resolves or compiles here and the numbers stay the same. That image's pip had put numpy 2.4.6 and pandas 3.1.1 over
# conda's numpy 1.26 (its def asked for numpy<2); the locks keep what ran. On Ubuntu 22.04 (2026-11-20) this
# environment gave the running image's template matching voxel for voxel (roadmap 63 §7, S6/S7 first trial).
# No NVIDIA base and no toolkit: cupy compiles pytom's kernels at run time with the environment's own NVRTC 12.9 and
# CUDA headers (cuda-nvrtc, cuda-cudart-dev); the driver comes from the host through --nv.

%files
    build_env.sh /opt/crboost/build_env.sh
    pytom-match-pick-0.14.0_cupy-13.6.0_cuda12.9_ubuntu24.04.conda.lock /opt/locks/conda.lock
    pytom-match-pick-0.14.0_cupy-13.6.0_cuda12.9_ubuntu24.04.pip.lock /opt/locks/pip.lock

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=""
    export PYTHONHOME=""
    export PATH="/opt/miniforge3/envs/pytom/bin:/opt/miniforge3/bin:$PATH"
    export LD_LIBRARY_PATH="/opt/miniforge3/envs/pytom/lib:$LD_LIBRARY_PATH"

%post
    set -e
    . /opt/crboost/build_env.sh
    apt_install ca-certificates curl
    install_miniforge

    conda create -n pytom -y --file /opt/locks/conda.lock
    P=/opt/miniforge3/envs/pytom/bin/python
    $P -m pip install --no-cache-dir --no-deps --only-binary :all: --require-hashes -r /opt/locks/pip.lock
    conda clean --all -y

    # Verify here, not in %test: a failing %test does not fail an Apptainer build.
    $P -m pip check
    $P -c "import pytom_tm, importlib.metadata as m; v = m.version('pytom-match-pick'); print('pytom-match-pick', v); assert v == '0.14.0', v"
    $P -c "import numpy, scipy, cupy; print('numpy', numpy.__version__, 'scipy', scipy.__version__, 'cupy', cupy.__version__); assert (numpy.__version__, cupy.__version__) == ('2.4.6', '13.6.0')"
    # No CUDA toolkit outside the environment: cupy must take its headers from the environment's own CUDA.
    test ! -e /usr/local/cuda
    # NVRTC (>= 12.8 targets sm_100) compiles a kernel the way cupy does, with cupy's own include directories; no
    # GPU or driver is needed for that. pytom_match_template.py --help initialises CUDA, so it runs on a GPU node.
    $P - <<'EOF'
import os
from cupy import _environment as env
from cupy._core.core import _get_header_dir_path
from cupy.cuda import nvrtc

assert nvrtc.getVersion() >= (12, 8), nvrtc.getVersion()
include = [_get_header_dir_path(), *(env._get_include_dir_from_conda_or_wheel(12, 9) or [])]
assert any(os.path.exists(os.path.join(d, "cuda_fp16.h")) for d in include[1:]), include
src = r'''
#include <cupy/complex.cuh>
#include <cuda_fp16.h>
extern "C" __global__ void k(const complex<float>* a, float* o, int n) {
    int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) o[i] = abs(a[i]) + __half2float(__float2half(1.0f));
}
'''
prog = nvrtc.createProgram(src, "k.cu", [], [])
nvrtc.compileProgram(prog, ["--gpu-architecture=sm_100", "--std=c++17", *(f"-I{d}" for d in include)])
print("nvrtc", nvrtc.getVersion(), "compiles for sm_100 from", include[1:])
EOF

%test
    # The real checks run at the end of %post (a failing %test does not fail the build).
    test -x /opt/miniforge3/envs/pytom/bin/pytom_match_template.py

%runscript
    if [ $# -gt 0 ]; then
        exec "$@"
    else
        exec /bin/bash
    fi

%labels
    crboost.tool pytom
    crboost.def pytom-match-pick-0.14.0_cupy-13.6.0_cuda12.9_ubuntu24.04
    org.opencontainers.image.title pytom-match-pick
    org.opencontainers.image.version 0.14.0
    org.opencontainers.image.source https://github.com/Klumpe-lab/crboost_server
    org.opencontainers.image.licenses GPL-2.0 (pytom-match-pick); conda-forge and PyPI packages under their own

%help
    pytom-match-pick 0.14.0 with cupy 13.6.0 on CUDA 12.9 from conda-forge (NVRTC 12.9 compiles for sm_100), on
    Ubuntu 24.04.
    Use with: apptainer exec --nv <image>.sif pytom_match_template.py
