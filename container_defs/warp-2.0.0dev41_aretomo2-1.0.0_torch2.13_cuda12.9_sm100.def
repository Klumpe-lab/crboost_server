Bootstrap: docker
From: nvidia/cuda@sha256:bd4e2680a261c212f1e2fea241606f71497dc67a417f73175d794ec8212b5ba8
# nvidia/cuda:12.9.1-devel-ubuntu22.04 on 2026-11-20, by digest (Apptainer takes a tag or a digest, not both).

# WarpTools 2.0.0dev41 with M (MTools, MCore) and AreTomo2 v1.0.0: every Warp job, particle export and M included.
# The image warp-2.0.0dev41_aretomo2-1.0.0_cuda12.9_sm100.def built, with PyTorch 2.13.0 in place of 2.14.1. The warp
# package asks for `pytorch * cuda129*`, unpinned, and that build took 2.14.1, which no longer has at::_ops::cholesky.
# Warp's LibTorchSharp was built against 2.13.0 and calls it, so .NET could not load the library and MTools and MCore
# died wherever they touch TorchSharp (the denoiser, Species.Commit()). WarpTools' commands never load it.
# The environment is that image's, installed from the lock beside this def (URL and md5 per package; nothing resolves
# here): pytorch and libtorch are the 2.13.0 cuda129_mkl build 302 that warp 2.0.0dev41 was built against, with what
# that build needs; every other package is the running image's.
# The CUDA 12.9 devel base is there to compile AreTomo2 (its makefile11 is written for CUDA 12). makefile11 stops at
# sm_86 with no PTX, so it is extended with Blackwell SASS and PTX (CBE.next's B200s are sm_100). The host GPU driver
# comes in through `apptainer exec --nv` and must support CUDA 12.9.

%files
    warp-2.0.0dev41_aretomo2-1.0.0_torch2.13_cuda12.9_sm100.conda.lock /opt/locks/conda.lock

%environment
    export PATH="/opt/aretomo2/bin:/opt/miniforge3/envs/warp/bin:$PATH"
    export LD_LIBRARY_PATH="/opt/miniforge3/envs/warp/lib:/usr/local/cuda/lib64:$LD_LIBRARY_PATH"
    export CUDA_PATH="/usr/local/cuda"
    export CUDA_HOME="/usr/local/cuda"

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Europe/Vienna
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

    # CBE.next builds run with --fakeroot --ignore-fakeroot-command (no subuid range), where only root is
    # mapped: apt cannot drop to its _apt user, and package scripts cannot chown to system users (EINVAL).
    # apt stays root, and chown/chgrp are diverted to versions that ignore that while packages install.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox
    for c in chown chgrp; do
        dpkg-divert --local --rename --add /usr/bin/$c
        printf '#!/bin/sh\n/usr/bin/%s.distrib "$@" 2>/dev/null || true\n' $c > /usr/bin/$c
        chmod +x /usr/bin/$c
    done
    apt-get update
    apt-get install -y --no-install-recommends \
        wget \
        git \
        build-essential \
        ca-certificates \
        libfontconfig1
    rm -rf /var/lib/apt/lists/*
    for c in chown chgrp; do rm /usr/bin/$c; dpkg-divert --local --rename --remove /usr/bin/$c; done
    test -z "$(dpkg --audit)"

    nvcc --version
    gcc --version

    #----- Warp -----#
    cd /tmp
    wget -q https://github.com/conda-forge/miniforge/releases/download/26.9.4-1/Miniforge3-26.9.4-1-Linux-x86_64.sh \
        -O miniforge.sh
    echo "571b410272cc434f28bc6c5c49ca8ffd4a4d1bcba9f57f1b6baccdb46446cfcc  miniforge.sh" | sha256sum -c -
    bash miniforge.sh -b -p /opt/miniforge3
    rm miniforge.sh
    export PATH="/opt/miniforge3/bin:$PATH"

    conda create -n warp -y --file /opt/locks/conda.lock
    conda clean --all -y

    # Checked before AreTomo2 compiles, so a wrong environment fails the build within minutes, with the library path
    # the image runs with. LibTorchSharp must resolve every symbol against this libtorch: ldd -r, then a dlopen the way
    # .NET loads it. torch._C._cuda_getArchFlags() works without a GPU (torch.cuda.get_arch_list() is empty there).
    W=/opt/miniforge3/envs/warp
    export LD_LIBRARY_PATH="$W/lib:/usr/local/cuda/lib64"
    ldd -r $W/lib/libLibTorchSharp.so > /tmp/libtorchsharp.ldd 2>&1 || true
    if grep -q -E 'undefined symbol|not found' /tmp/libtorchsharp.ldd; then cat /tmp/libtorchsharp.ldd; exit 1; fi
    rm /tmp/libtorchsharp.ldd
    $W/bin/python -c "import ctypes; ctypes.CDLL('$W/lib/libLibTorchSharp.so'); print('LibTorchSharp loads')"
    $W/bin/python -c "import torch; v = torch.__version__; print('torch', v); assert v == '2.13.0', v"
    $W/bin/python -c "import torch; f = torch._C._cuda_getArchFlags(); print(f); assert 'sm_100' in f, f"
    unset LD_LIBRARY_PATH

    #----- AreTomo2 v1.0.0 from source -----#
    mkdir -p /opt/aretomo2/bin
    cd /tmp
    rm -rf AreTomo2
    git clone https://github.com/czimaginginstitute/AreTomo2.git
    cd AreTomo2
    git checkout v1.0.0
    sed -i 's|-o AreTomo2|-no-pie -o AreTomo2|' makefile11
    # Add Blackwell SASS and compute_100 PTX (the PTX lets the driver JIT for GPUs newer than sm_100).
    sed -i 's|-gencode arch=compute_86,code=sm_86|-gencode arch=compute_86,code=sm_86 -gencode arch=compute_100,code=sm_100 -gencode arch=compute_100,code=compute_100|' makefile11
    grep -q 'code=sm_100' makefile11
    make exe -f makefile11 CUDAHOME=/usr/local/cuda PRJLIB=./Lib
    mv AreTomo2 /opt/aretomo2/bin/
    chmod +x /opt/aretomo2/bin/AreTomo2
    ln -s /opt/aretomo2/bin/AreTomo2 /usr/local/bin/AreTomo
    cd /
    rm -rf /tmp/AreTomo2
    apt-get clean

    # Verify here, not in %test: a failing %test does not fail an Apptainer build. With the image's library path.
    export LD_LIBRARY_PATH="$W/lib:/usr/local/cuda/lib64"
    # dev40+ only: the environment holds the Warp it should.
    $W/bin/WarpTools ts_export_particles --help 2>&1 | grep -q -- "--dont_premultiply"
    # M's tools start: the .NET runtime, ICU and their assemblies load.
    $W/bin/MTools create_species --help 2>&1 | grep -q -- "--dont_use_denoiser"
    $W/bin/MCore --help 2>&1 | grep -q -- "--refine_imagewarp"
    # AreTomo2 must carry Blackwell SASS and PTX.
    cuobjdump --list-elf /opt/aretomo2/bin/AreTomo2 | grep -q sm_100
    cuobjdump --list-ptx /opt/aretomo2/bin/AreTomo2 | grep -q sm_100

%test
    # The real checks run at the end of %post (a failing %test does not fail the build).
    test -x /opt/aretomo2/bin/AreTomo2

%labels
    Tool WarpTools+M+AreTomo2
    Version 2.0.0dev41+1.0.0
    PyTorch 2.13.0 cuda129_mkl build 302
    CUDA 12.9
    GPU sm_52-sm_100 + compute_100 PTX

%help
    WarpTools 2.0.0dev41 with M (MTools, MCore) and AreTomo2 v1.0.0 (CUDA 12.9, AreTomo2 built for sm_52-sm_100), with
    the PyTorch 2.13.0 that Warp's LibTorchSharp was built against, for every crboost Warp job and M.

    Usage:
      apptainer exec --nv <image>.sif WarpTools --help
      apptainer exec --nv <image>.sif MCore --help
      apptainer exec --nv <image>.sif AreTomo2

    CUDA 12.9 needs a recent host NVIDIA driver; a driver/forward-compat error on the first run means
    the GPU node's driver is too old.
