Bootstrap: docker
From: ubuntu:22.04

# WarpTools 2.0.0dev41 for the warpExport job only (`ts_export_particles --2d`).
# Every other Warp job stays on warp_2.0.0dev36_aretomo1.0.0_cuda11.8_glibc2.31.sif.
#
# Why a second Warp: dev40 (commit 7ad2dcc) fixed the RELION particle-series export that dev36 gets
# wrong — one stack slice per visible tilt (dev36 writes every tilt, so RELION pairs slices with the
# wrong tilts), the depth-defocus scale, rlnTomoHand — and added --dont_premultiply. dev41 is the
# newest tag; its export command is identical to main's.
#
# Upstream install line (docs/user_guide/warptools/installation.md); %post pins warp=2.0.0dev41 and moves the
# channel priority into the conda config:
#   conda create -n warp warp -c warpem -c nvidia/label/cuda-12.9.0 -c conda-forge --channel-priority flexible
# The package brings its own CUDA 12.9 runtime, pytorch (cuda129) and dotnet 10, so the base image is
# plain Ubuntu and conda is the only CUDA source (same layout as miss_alignment_torch2.8.0_cuda12.9.def).
# The host GPU driver comes in through `apptainer exec --nv`.

%environment
    export PATH="/opt/miniforge3/envs/warp/bin:$PATH"
    export LD_LIBRARY_PATH="/opt/miniforge3/envs/warp/lib:$LD_LIBRARY_PATH"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        libfontconfig1 \
        && rm -rf /var/lib/apt/lists/*

    cd /opt
    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O miniforge.sh
    bash miniforge.sh -b -p /opt/miniforge3
    rm miniforge.sh
    export PATH="/opt/miniforge3/bin:$PATH"

    # conda 26 no longer takes `--channel-priority <value>` on the command line; set it in the config instead.
    conda config --system --set channel_priority flexible
    # The build host has no GPU, so conda sees no __cuda virtual package and refuses pytorch's cuda129 build.
    CONDA_OVERRIDE_CUDA=12.9 conda create -n warp -y warp=2.0.0dev41 \
        -c warpem -c nvidia/label/cuda-12.9.0 -c conda-forge

    echo "--- BUILD VERIFICATION ---"
    /opt/miniforge3/envs/warp/bin/WarpTools ts_export_particles --help || echo "WARN: ts_export_particles --help returned nonzero"

    conda clean --all -y

%test
    # dev40+ only: proves the solver did not fall back to an older Warp.
    /opt/miniforge3/envs/warp/bin/WarpTools ts_export_particles --help 2>&1 | grep -q -- "--dont_premultiply"

%labels
    Tool WarpTools
    Version 2.0.0dev41
    CUDA 12.9

%help
    WarpTools 2.0.0dev41 (CUDA 12.9) for crboost's warpExport job.

    Usage:
      apptainer exec --nv <image>.sif WarpTools ts_export_particles --help

    CUDA 12.9 needs a recent host NVIDIA driver; a driver/forward-compat error on the first run means
    the GPU node's driver is too old.
