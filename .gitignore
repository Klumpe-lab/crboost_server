# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# The Python environment install.sh builds, and the venv link to it (a link or a directory: no trailing slash)
/.uv
/venv

# NiceGUI's storage from before it moved to ~/.crboost/nicegui
.nicegui/

# Site config, made from the templates by ./crboost preflight, and its backups
/config/conf.yaml*
/config/qsub.sh*

# Secrets and local environment
.env
auth/
.claude/

# Data: projects, volumes, images, weights (the protocol bundles' assets are the exception)
projects/
user_jobs/
tmpOut/
**/*.cif
**/*.mrc
!config/protocols/*/assets/*.mrc
*.sif
*.pth

# Notes and scratch: the maintainer's, never part of the repo
/notes/
/memory/
/docs/roadmaps/
/docs/reports/
/scripts/file_roadmap_issues.py
q_*.md
PLAN_*.md
REPORT_*.md
ISSUE_*.md
