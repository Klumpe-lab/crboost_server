#!/bin/sh
# Starts the server with this checkout's own Python (venv/, built by install.sh) and nothing else: whatever the
# shell has loaded (cluster modules, conda, another venv, PYTHONPATH) is left out, and jobs inherit that.
here=$(cd "$(dirname "$0")" && pwd -P) || exit 1
py="$here/venv/bin/python3"
if [ ! -x "$py" ]; then
    echo "crboost: $py not found; run $here/install.sh" >&2
    exit 1
fi
unset PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE VIRTUAL_ENV CONDA_PREFIX
export PYTHONNOUSERSITE=1
exec "$py" "$here/crboost.py" "$@"
